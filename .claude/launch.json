{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oulipao",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build >/dev/null && exec python3 -m http.server \"${PORT:-8765}\""
      ],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "oulipao-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "_site"
      ],
      "port": 8766
    }
  ]
}
