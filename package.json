{
  "name": "oulipao",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Ouvroir de Littérature Potentielle Assistée par Ordinateur — essai technique : étiquetage grammatical du français dans le navigateur",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild page=src/ui/page.ts tracks=src/ui/tracks/main.ts --bundle --format=esm --target=es2022 --outdir=dist --sourcemap --define:__OULIPAO_VERSION__=\\\"$npm_package_version\\\"",
    "build:site": "node scripts/build-site.ts",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-exclude='test/**' --test-coverage-exclude='vendor/**' --test-coverage-exclude='src/adapters/taggers/camembert-model.ts' --test-coverage-exclude='src/ui/page.ts' --test-coverage-exclude='src/ui/tracks/main.ts' 'test/**/*.test.ts'",
    "check:palette": "node scripts/check-palette.ts",
    "measure": "node scripts/measure.ts",
    "build:references": "node scripts/build-references.ts",
    "build:lexicon": "node scripts/build-lexicon.ts",
    "build:morphology": "node scripts/build-morphology.ts",
    "build:verbs": "node scripts/build-verbs.ts",
    "transform:references": "node scripts/transform-references.ts",
    "build:phonetics": "node scripts/build-phonetics.ts"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "preact-render-to-string": "^6.8.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  }
}
